#!/usr/bin/env bash
# Run the ylang console script from this workspace's virtualenv.
set -euo pipefail

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
APP_ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
WS_ROOT="$(cd "$APP_ROOT/.." && pwd)"

ENV_FILE="${YLANG_ENV_FILE:-$WS_ROOT/ylang.env}"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck source=/dev/null
  source "$ENV_FILE"
  set +a
fi

# Prefer a venv that can actually import ylang. app/.venv may exist but be
# broken after a Python upgrade; the service venv lives at the workspace root.
for candidate in \
  "$WS_ROOT/.venv/bin/ylang" \
  "$APP_ROOT/.venv/bin/ylang"; do
  if [[ -x "$candidate" ]]; then
    py="${candidate%/ylang}/python"
    if [[ -x "$py" ]] && "$py" -c 'import ylang' >/dev/null 2>&1; then
      exec "$candidate" "$@"
    fi
  fi
done

echo "ylang: no working virtualenv CLI found. From app/: python3 -m venv .venv && source .venv/bin/activate && pip install -e ." >&2
echo "  (see docs/installation.md)" >&2
exit 127
